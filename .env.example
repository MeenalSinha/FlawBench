# Copy to `.env` (never commit `.env`). Real environment variables win over this file.
# Every variable is optional; defaults live in src/flawbench/config.py.

# FLAWBENCH_CONFIG=configs/config.yaml
# FLAWBENCH_PROJECT_ROOT=
# FLAWBENCH_APP_NAME=FlawBench
# FLAWBENCH_ENV=development
# FLAWBENCH_LOG_LEVEL=INFO
# FLAWBENCH_REFERENCE_DIR=data/reference
# FLAWBENCH_GENERATED_DIR=data/generated
# FLAWBENCH_METADATA_DIR=data/metadata
# FLAWBENCH_OUTPUT_DIR=outputs
# FLAWBENCH_AUDIO_EXTENSIONS=.wav,.flac,.ogg,.mp3
# FLAWBENCH_MAX_UPLOAD_MB=50
# FLAWBENCH_MIN_SAMPLE_RATE_HZ=8000
# FLAWBENCH_MAX_CHANNELS=2
# FLAWBENCH_REJECT_NON_FINITE=true
# FLAWBENCH_PAGE_TITLE=FlawBench - Speech Flaw Analysis
# FLAWBENCH_LAYOUT=wide
# FLAWBENCH_SHOW_ROADMAP=true
# FLAWBENCH_DETAILED_LOGGING=false
# FLAWBENCH_EXPOSE_ERROR_DETAILS=false

# --- Phase 2: dataset engine ---
# FLAWBENCH_DATASET_ID=flawbench-v1
# FLAWBENCH_SOURCES_FILENAME=sources.jsonl
# FLAWBENCH_MANIFEST_FILENAME=manifest.jsonl
# FLAWBENCH_RUNS_FILENAME=runs.jsonl
# FLAWBENCH_SPLITS_FILENAME=splits.json
# FLAWBENCH_COPY_REFERENCE=false
# FLAWBENCH_ALLOW_OVERWRITE=false
# FLAWBENCH_OUTPUT_SUBTYPE=FLOAT
# FLAWBENCH_PLACEMENT_MARGIN_SEC=0.25
# FLAWBENCH_MAX_OUTPUT_SECONDS=600
# FLAWBENCH_MAX_VARIANTS_PER_RUN=1000
# FLAWBENCH_DURATION_TOLERANCE_SEC=0.001
# FLAWBENCH_SPLIT_SEED=1337
# Mapping-valued settings take a JSON object (replaces the whole mapping):
# FLAWBENCH_SPLIT_RATIOS={"train":0.7,"validation":0.15,"test":0.15}
# FLAWBENCH_SEVERITY_PROFILES={"pause_insertion":{"low":{"duration_sec":0.5}}, "tempo_change":{"low":{"rate":0.85,"segment_sec":2.0}}, "energy_reduction":{"low":{"gain_db":-6.0,"segment_sec":2.0}}}
# FLAWBENCH_PARAMETER_BOUNDS={"pause_insertion":{"duration_sec":{"min":0.05,"max":30}}, "tempo_change":{"rate":{"min":0.25,"max":4},"segment_sec":{"min":0.25,"max":30}}, "energy_reduction":{"gain_db":{"min":-60,"max":-0.5},"segment_sec":{"min":0.05,"max":30}}}

# --- Phase 3: feature extraction & time-series analysis ---
# FLAWBENCH_FEAT_FRAME_MS=25.0
# FLAWBENCH_FEAT_HOP_MS=10.0
# FLAWBENCH_FEAT_N_MFCC=13
# FLAWBENCH_FEAT_ROLLOFF_P=0.85
# FLAWBENCH_FEAT_PITCH_BACKEND=librosa_pyin
# FLAWBENCH_FEAT_F0_MIN_HZ=75.0
# FLAWBENCH_FEAT_F0_MAX_HZ=600.0
# FLAWBENCH_FEAT_CHANNEL_POLICY=mono_mix
# FLAWBENCH_FEAT_SILENCE_DB=-40.0
# FLAWBENCH_FEAT_MIN_SILENCE_MS=50.0
# FLAWBENCH_FEATURES_DIR=data/features
# FLAWBENCH_FEAT_MANIFEST_FILENAME=feature_manifest.jsonl
# FLAWBENCH_FEAT_CACHE_POLICY=skip_if_valid
# FLAWBENCH_FEAT_MAX_SECONDS=600.0
# FLAWBENCH_FEAT_SCHEMA_VERSION=3.0

# --- Phase 4: flaw detection & temporal localization ---
# FLAWBENCH_DETECT_ENABLED=pause_insertion,tempo_change,energy_reduction
# FLAWBENCH_DETECT_PAUSE_THRESH_DB=-35.0
# FLAWBENCH_DETECT_PAUSE_MIN_SEC=0.15
# FLAWBENCH_DETECT_PAUSE_DIFF_SEC=0.10
# FLAWBENCH_DETECT_TEMPO_DEV=0.15
# FLAWBENCH_DETECT_TEMPO_MIN_SEC=0.25
# FLAWBENCH_DETECT_ALIGN_METRIC=euclidean
# FLAWBENCH_DETECT_ALIGN_NO_C0=true
# FLAWBENCH_DETECT_TEMPO_WINDOW_SEC=0.5
# FLAWBENCH_DETECT_TEMPO_MAX_INACTIVE=0.2
# FLAWBENCH_DETECT_PAUSE_MAX_VOICED=0.25
# FLAWBENCH_DETECT_ENERGY_THRESH_DB=-4.0
# FLAWBENCH_DETECT_ENERGY_MIN_SEC=0.15
# FLAWBENCH_DETECT_MERGE_GAP_SEC=0.05
# FLAWBENCH_DETECT_MIN_CAND_SEC=0.08
# FLAWBENCH_DETECTIONS_DIR=data/detections
# FLAWBENCH_DETECT_MANIFEST_FILENAME=detections_manifest.jsonl
# FLAWBENCH_DETECT_CACHE_POLICY=skip_if_valid
# FLAWBENCH_DETECT_SCHEMA_VERSION=4.0

# --- Phase 5: formal evaluation & benchmarking ---
# FLAWBENCH_EVAL_DEFAULT_SPLIT=test
# FLAWBENCH_EVAL_IOU_THRESH=0.5
# FLAWBENCH_EVAL_LOC_IOU_THRESHOLDS=0.3,0.5,0.7,0.9
# FLAWBENCH_EVAL_REQUIRE_CAT_MATCH=true
# FLAWBENCH_EVAL_ZERO_DENOM_POLICY=undefined
# FLAWBENCH_EVAL_BOOTSTRAP_REPLICATES=0
# FLAWBENCH_EVAL_BOOTSTRAP_SEED=1337
# FLAWBENCH_EVAL_INCLUDE_CONTROLS=true
# FLAWBENCH_EVALUATIONS_DIR=outputs/evaluations
# FLAWBENCH_EVAL_MANIFEST_FILENAME=evaluations_manifest.jsonl
# FLAWBENCH_EVAL_SCHEMA_VERSION=5.0

# --- Phase 6: participant analysis, explanations and reports
# FLAWBENCH_EXPLAIN_DEFAULT_PAGE=overview
# FLAWBENCH_EXPLAIN_ANALYSIS_MODES=registered_variant,uploaded_participant
# FLAWBENCH_EXPLAIN_VERBOSITY=standard
# FLAWBENCH_EXPLAIN_SORT_POLICY=chronological
# FLAWBENCH_EXPLAIN_PLAYBACK_CONTEXT_SEC=1.0
# FLAWBENCH_EXPLAIN_MAX_EXCERPT_SEC=30.0
# FLAWBENCH_EXPLAIN_SHOW_TECHNICAL_EVIDENCE=true
# FLAWBENCH_EXPLAIN_TRANSCRIPT_FORMATS=.txt
# FLAWBENCH_EXPLAIN_TRANSCRIPT_SIMILARITY_WARNING=0.8
# FLAWBENCH_EXPLAIN_ALIGNMENT_DURATION_RATIO_WARNING=2.0
# FLAWBENCH_EXPLAIN_UPLOAD_PERSISTENCE=explicit_registration
# FLAWBENCH_EXPLAIN_REPORTS_DIR=outputs/participant_reports
# FLAWBENCH_EXPLAIN_EXPORT_FORMATS=markdown,html,json,csv
# FLAWBENCH_EXPLAIN_SAVE_REPORTS_AUTOMATICALLY=false
# FLAWBENCH_EXPLAIN_SHOW_BENCHMARK_CONTEXT=true

